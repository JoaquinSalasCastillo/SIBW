{% extends "base_usuario.twig" %}

{% block titulo %}
    Editar usuario
{% endblock %}

{% block body %}
    <h1>Editar Usuario</h1>
    <form method="post" action="editar_usuario.php">
        <label for="nombre">Nombre:</label><br>
        <input type="text" id="nombre" name="nombre" value="{{ usuario.nombre }}"><br>
        <label for="password">Contraseña:</label><br>
        <input type="password" id="password" name="password" value="{{ usuario.password }}"><br>
        <label for="email">Email:</label><br>
        <input type="email" id="email" name="email" value="{{ usuario.email }}"><br>
        <input type="submit" value="Editar">
    </form>
{% endblock %}