<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block titulo %}SIBW{% endblock %}</title>
    <!-- Estilos -->
    <link rel="stylesheet" href="styles/sesiones_estilo.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    {% block estilos %}
    {% endblock %}
</head>
<body>
    <!-- Botones de inicio de sesion -->
    <div id="sesiones">
        {% if usuarioData.loggedIn %}
            <a href="logout.php"><button type="button">Cerrar sesión</button></a>
            <a href="editar_usuario.php"><button type="button">Editar usuario</button></a>
            {% if usuarioData.usuario.rol == 'superusuario' %}
                <a href="administrar_usuarios.php"><button type="button">Administrar usuarios</button></a>
            {% endif %}
            {% if usuarioData.usuario.rol == 'moderador' or usuarioData.usuario.rol == 'superusuario' %}
                <a href="administrar_comentarios.php"><button type="button">Administrar Comentarios</button></a>
            {% endif %}
            {% if usuarioData.usuario.rol == 'gestor' or usuarioData.usuario.rol == 'superusuario' %}
                <a href="administrar_actividades.php"><button type="button">Administrar Actividades</button></a>
            {% endif %}
            <p>Bienvenido {{ usuarioData.usuario.nombre }}, rol: {{ usuarioData.usuario.rol }}</p>
        {% else %}
            <a href="register.php"><button type="button">Registrarse</button></a>
            <a href="login.php"><button type="button">Iniciar sesión</button></a>
        {% endif %}
    </div>
    <!-- Cabecera de la pagina con logo, nombre y menu -->
    <header class="caja">
        <img id="logo" src="img/logo_montañismo.png" alt="logo_montaña">
        <div>
            <!-- Titulo -->
            <h1>AVENTURAS EN LA MONTAÑA</h1>
            <!-- Menu de navegacion -->
            <nav>
                <a href="">Menu 1</a>
                <a href="">Menu 2</a>
                <a href="">Menu 3</a>
            </nav>
        </div>
    </header>

    <!-- Contenido principal con la informacion de las actividades y zona auxiliar -->
    <main class="flex-container">
        <!-- Zona lateral con información auxiliar -->
        <aside id="lateral" class="caja">
            <h2>Enlaces de interés</h2>
            <ul>
                <li><a href="#">Equipamiento necesario</a></li>
                <li><a href="#">Rutas recomendadas</a></li>
                <li><a href="#">Consejos de seguridad</a></li>
                <li><a href="#">Eventos próximos</a></li>
            </ul>
        </aside>
        <!-- Zona principal -->
        {% block central %}
        <article id="principal" class="caja">
            <p>Parte central de las plantillas</p>
        </article>
        {% endblock %}
    </main>
    
    <!-- Pie de pagina con copyright e informacion de contacto  -->
    <footer class="caja">
        <p>Todos los derechos reservados.</p>
        <address>
            <p><strong>Joaquin</strong></p>
            <p><strong>Email: </strong> joaquin@correo.com</p>
        </address>
        <p>© 2024 - Joaquin</p>
    </footer>

    {% block comentarios %}
    {% endblock %}

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% block scripts %}
    {% endblock %}
</body>
</html>