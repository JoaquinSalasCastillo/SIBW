{% extends "base_administrar.twig" %}

{% block titulo %}
    Administrar Usuarios
{% endblock %}

{% block estilos %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
{% endblock %}

{% block contenido %}
<h1>Administrar Usuarios</h1>
<div class="row">
    {% for usuario in usuarios %}
        <div class="col-sm-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">{{ usuario.nombre }}</h5>
                    <p class="card-text">Rol actual: {{ usuario.rol }}</p>
                    <form action="administrar_usuarios.php" method="post">
                        <div class="form-group mb-3">
                            <label for="nuevoRol{{ usuario.nombre }}">Cambiar rol:</label>
                            <select class="form-control" name="nuevoRol" id="nuevoRol{{ usuario.nombre }}">
                                <option value="registrado" {% if usuario.rol == 'registrado' %}selected{% endif %}>Registrado</option>
                                <option value="moderador" {% if usuario.rol == 'moderador' %}selected{% endif %}>Moderador</option>
                                <option value="gestor" {% if usuario.rol == 'gestor' %}selected{% endif %}>Gestor</option>
                                <option value="superusuario" {% if usuario.rol == 'superusuario' %}selected{% endif %}>Superusuario</option>
                            </select>
                        </div>
                        <input type="hidden" name="nombreUsuario" value="{{ usuario.nombre }}">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
